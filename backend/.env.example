# Generate a long random secret and set it in the hosting provider's secret/environment settings.
AIVS_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Keep the default GitHub Pages origin unless the frontend domain changes.
AIVS_ALLOWED_ORIGINS=https://fertager2011-blip.github.io

# Maximum source video size in MB.
AIVS_MAX_UPLOAD_MB=500

# Use a persistent disk mounted at this path on the hosting provider.
AIVS_DATA_DIR=/app/data
